    "characters": "ownedCharacters.length",
    "pets": "pets.length",
    "skills": "skills.length",
    "streak": "dailyStreak",
    "guild": "1 once guildId is set",
    "bio": "1 once a bio is set",
    "pfp": "1 once a profile picture is set",
    "title": "1 once a title is set",
    "chest": "1 once the safe chest is unlocked",
    "ender": "1 once the ender chest is unlocked",
    "enchantBook": "1 once the enchanting book is bought",
    "premium": "1 while a premium plan is active",
    "storyVolumes": "storyProgress.volumes finished",
